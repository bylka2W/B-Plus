state Init @Cache(L1) {
    var x : int32 @Cache(L1)
    var y : int32 @Cache(L1)
    var z : int32 @Cache(L1)
    entry { 
        print("INIT\n") 
        x = 10
        y = 20
        z = x + y
    }
    always -> Process
}

state Process @Cache(L2) {
    var buf : byte @Cache(L1)
    var result : int32 @Cache(L1)
    entry {
        print("PROCESS\n")
        buf = 0
        result = 100
    }
    always -> Validate
}

state Validate @Cache(L1) {
    var data : int32 @Cache(L1)
    var check : int32 @Cache(L1)
    entry {
        print("VALIDATE\n")
        data = 42
        check = data * 2
    }
    always -> Final
}

state Skip @Cache(L3) {
    entry { print("SKIP\n") }
    always -> Final
}

state Final {
    var out : byte @Cache(Disk)
    entry {
        print("FINAL\n")
        out = 1
    }
    always -> Init
}