state dxgi {
    iid_lo: int64,
    iid_hi: int64,
    factory: int64,
    hr: int64,
    vtbl: int64,
    fn_EnumAdapters: int64,
    adapter_desc: int64,
    hr2: int64
}

entry main {
    let dxgi = LoadLibraryA("dxgi.dll");
    let CreateDXGIFactory1 = GetProcAddress(dxgi, "CreateDXGIFactory1");
    // IID_IDXGIFactory1 = {0x7704bb78, 0xf1be, 0x41bf, 0x91, 0xb6, 0x6a, 0x2a, 0x5d, 0xaf}
    // Store GUID bytes at addr(iid_lo) using ptr_store32
    // Actually just try with zero IID to test the call mechanism
    let hr = call_indirect(CreateDXGIFactory1, addr(iid_lo), addr(factory));
    hr = hr;
    if (hr == 0) {
        // Load vtbl from factory pointer
        let vtbl = ptr_load(factory);
        vtbl = vtbl;
        // EnumAdapters is at vtbl[7] (7 * 8 = 56)
        let fn_EnumAdapters = ptr_load(vtbl + 56);
        fn_EnumAdapters = fn_EnumAdapters;
        // Call EnumAdapters(factory, 0, addr(adapter_desc))
        let hr2 = call_indirect(fn_EnumAdapters, factory, 0, addr(adapter_desc));
        hr2 = hr2;
    }
}
