state DXGI {
    real_dxgi, factory, hr, orig_vtbl, new_vtbl, orig_CreateSwapChain, out_addr
    swapchain, sw_orig_vtbl, sw_new_vtbl, orig_present, entry
    bb_width, bb_height, out_width, out_height, frame_idx, p, tmp

    // Init flag + device/context
    init_done, device, context, backbuffer, buf_addr, swap_desc_addr, sw_vtbl

    // CSO file handles (4 passes: accumulate/RCAS/EASU/luminance)
    cso_a, cso_r, cso_e, cso_lp, cso_dc, cso_lk, cso_rd, cso_dv
    cso_size, cso_buf, read, file, size_hi, size_lo

    // Shader pointers
    sh_a, sh_r, sh_e, sh_lp, sh_dc, sh_lk, sh_rd, sh_dv

    // GUID buffers
    g_buf

    // Intermediate texture ptrs — reused variables
    t0, t1, t2, t3, t4, t5, t6

    // SRV views
    sv_bb, sv_hc, sv_up, sv_hd, sv_hl, sv_lu

    // UAV views
    uv_hc, uv_up, uv_dc, uv_lk, uv_lu, uv_dm

    // Cached vtbl entries
    dv_cs, dv_t2d, dv_srv, dv_uav, dv_immctx
    cv_dispatch, cv_css, cv_cssr, cv_csuav, cv_copy
    bb_vtbl
}

export entry CreateDXGIFactory {
    if (real_dxgi == 0) {
        real_dxgi = LoadLibraryA("C:\\Windows\\System32\\dxgi.dll\0")
    }
    factory = 0
    out_addr = addr(factory)
    hr = call_indirect(GetProcAddress(real_dxgi, "CreateDXGIFactory\0"), addr(factory), out_addr)
    if (hr < 0) { ret hr }
    orig_vtbl = ptr_load(factory)
    new_vtbl = HeapAlloc(GetProcessHeap(), 8, 120)
    entry = ptr_load(orig_vtbl)       ; ptr_store(new_vtbl, entry)
    entry = ptr_load(orig_vtbl + 8)   ; ptr_store(new_vtbl + 8, entry)
    entry = ptr_load(orig_vtbl + 16)  ; ptr_store(new_vtbl + 16, entry)
    entry = ptr_load(orig_vtbl + 24)  ; ptr_store(new_vtbl + 24, entry)
    entry = ptr_load(orig_vtbl + 32)  ; ptr_store(new_vtbl + 32, entry)
    entry = ptr_load(orig_vtbl + 40)  ; ptr_store(new_vtbl + 40, entry)
    entry = ptr_load(orig_vtbl + 48)  ; ptr_store(new_vtbl + 48, entry)
    entry = ptr_load(orig_vtbl + 56)  ; ptr_store(new_vtbl + 56, entry)
    entry = ptr_load(orig_vtbl + 64)  ; ptr_store(new_vtbl + 64, entry)
    entry = ptr_load(orig_vtbl + 72)  ; ptr_store(new_vtbl + 72, entry)
    entry = ptr_load(orig_vtbl + 80)  ; ptr_store(new_vtbl + 80, entry)
    entry = ptr_load(orig_vtbl + 88)  ; ptr_store(new_vtbl + 88, entry)
    entry = ptr_load(orig_vtbl + 96)  ; ptr_store(new_vtbl + 96, entry)
    entry = ptr_load(orig_vtbl + 104) ; ptr_store(new_vtbl + 104, entry)
    orig_CreateSwapChain = ptr_load(orig_vtbl + 80)
    ptr_store(new_vtbl + 80, @entry_addr("OnCreateSwapChain"))
    entry = ptr_load(orig_vtbl + 104)
    if (entry != 0) { ptr_store(new_vtbl + 104, @entry_addr("OnCreateSwapChainForHwnd")) }
    ptr_store(factory, new_vtbl)
    ret hr
}

export entry CreateDXGIFactory1 {
    if (real_dxgi == 0) {
        real_dxgi = LoadLibraryA("C:\\Windows\\System32\\dxgi.dll\0")
    }
    factory = 0
    out_addr = addr(factory)
    hr = call_indirect(GetProcAddress(real_dxgi, "CreateDXGIFactory1\0"), addr(factory), out_addr)
    if (hr < 0) { ret hr }
    orig_vtbl = ptr_load(factory)
    new_vtbl = HeapAlloc(GetProcessHeap(), 8, 120)
    entry = ptr_load(orig_vtbl)       ; ptr_store(new_vtbl, entry)
    entry = ptr_load(orig_vtbl + 8)   ; ptr_store(new_vtbl + 8, entry)
    entry = ptr_load(orig_vtbl + 16)  ; ptr_store(new_vtbl + 16, entry)
    entry = ptr_load(orig_vtbl + 24)  ; ptr_store(new_vtbl + 24, entry)
    entry = ptr_load(orig_vtbl + 32)  ; ptr_store(new_vtbl + 32, entry)
    entry = ptr_load(orig_vtbl + 40)  ; ptr_store(new_vtbl + 40, entry)
    entry = ptr_load(orig_vtbl + 48)  ; ptr_store(new_vtbl + 48, entry)
    entry = ptr_load(orig_vtbl + 56)  ; ptr_store(new_vtbl + 56, entry)
    entry = ptr_load(orig_vtbl + 64)  ; ptr_store(new_vtbl + 64, entry)
    entry = ptr_load(orig_vtbl + 72)  ; ptr_store(new_vtbl + 72, entry)
    entry = ptr_load(orig_vtbl + 80)  ; ptr_store(new_vtbl + 80, entry)
    entry = ptr_load(orig_vtbl + 88)  ; ptr_store(new_vtbl + 88, entry)
    entry = ptr_load(orig_vtbl + 96)  ; ptr_store(new_vtbl + 96, entry)
    entry = ptr_load(orig_vtbl + 104) ; ptr_store(new_vtbl + 104, entry)
    orig_CreateSwapChain = ptr_load(orig_vtbl + 80)
