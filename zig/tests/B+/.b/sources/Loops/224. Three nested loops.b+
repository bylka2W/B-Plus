fn main()
{
    total = 0

    for i = 0;
        i < 10;
        i = i + 1
    {
        for j = 0;
            j < 10;
            j = j + 1
        {
            for k = 0;
                k < 10;
                k = k + 1
            {
                total += i + j + k
            }
        }
    }

    print(total)
}