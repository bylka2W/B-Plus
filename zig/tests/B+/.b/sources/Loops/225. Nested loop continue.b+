fn main()
{
    total = 0

    for i = 0;
        i < 20;
        i = i + 1
    {
        if i % 2 == 0
        {
            continue
        }

        for j = 0;
            j < 20;
            j = j + 1
        {
            if j % 3 == 0
            {
                continue
            }

            total += i * j
        }
    }

    print(total)
}