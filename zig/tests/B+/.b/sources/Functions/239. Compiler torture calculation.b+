fn calculate(a, b, c)
{
    x = (a + b) * c
    y = x / 2
    z = y % 7

    if z == 0
    {
        return x
    }
    else if z < 3
    {
        return x + z
    }
    else
    {
        return x - z
    }
}

fn main()
{
    result = 0

    for i = 1;
        i <= 100;
        i = i + 1
    {
        a = calculate(i, i + 1, i + 2)

        if a > 1000
        {
            result += a
        }
        else
        {
            result += a * 2
        }
    }

    print(result)
}