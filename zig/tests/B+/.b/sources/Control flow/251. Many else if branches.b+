fn main()
{
    x = 50
    result = 0

    if x > 100
    {
        result = 1
    }
    else if x > 75
    {
        result = 2
    }
    else if x > 50
    {
        result = 3
    }
    else if x == 50
    {
        result = 4
    }
    else if x > 25
    {
        result = 5
    }
    else
    {
        result = 6
    }

    print(result)
}