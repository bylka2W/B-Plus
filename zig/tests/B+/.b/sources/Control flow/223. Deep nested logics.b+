fn check(a, b, c, d)
{
    if a > 0
       && b > 0
    {
        if c > 0
           || d > 0
        {
            if !(a == b)
            {
                return true
            }
        }
    }

    return false
}

fn main()
{
    a = 10
    b = 20
    c = -5
    d = 30

    result = check(a, b, c, d)

    if result
    {
        print("PASS")
    }
    else
    {
        print("FAIL")
    }
}