struct Device
{
    id: i64
    value: i64
    enabled: bool
}

fn increment(device)
{
    device.value += 1
}

fn main()
{
    device = Device{}

    device.id = 100
    device.value = 0
    device.enabled = true

    for i = 0;
        i < 10;
        i = i + 1
    {
        if device.enabled
        {
            increment(device)
        }
    }

    result = device.value & 15

    if result == 10
    {
        print("B+ FINAL PASS")
    }
    else
    {
        print("B+ FINAL FAIL")
    }
}