struct Device
{
    id: i64
    value: i64
    limit: i64
    enabled: bool
}

fn clamp(device)
{
    if device.value < 0
    {
        device.value = 0
    }

    if device.value > device.limit
    {
        device.value = device.limit
    }
}

fn update(device, amount)
{
    if !device.enabled
    {
        return
    }

    p = &device.value

    *p += amount

    clamp(device)
}

fn calculate(device)
{
    result = 0

    for i = 0;
        i < 100;
        i = i + 1
    {
        if i % 3 == 0
        {
            result += device.value
        }
        else if i % 2 == 0
        {
            result += device.value * 2
        }
        else
        {
            result += device.value / 2
        }
    }

    return result
}

fn main()
{
    device = Device{}

    device.id = 1337
    device.value = 0
    device.limit = 100
    device.enabled = true

    for i = 0;
        i < 50;
        i = i + 1
    {
        update(device, i)

        if device.value == device.limit
        {
            break
        }
    }

    result = calculate(device)

    print(device.id)
    print(device.value)
    print(result)
}