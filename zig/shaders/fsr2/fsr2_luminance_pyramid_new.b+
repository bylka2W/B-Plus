kernel LuminancePyramid {
    g_InputColor : Texture2D<float4> @binding(t0)
    g_LumaOutput : RWTexture2D<float> @binding(u0)
    linearClamp  : SamplerState @binding(s0)
    inputSize    : float2 @cbuffer(0)
    inputRcpSize : float2 @cbuffer(0)
    mipLevel     : int @cbuffer(0)
    globals {
        float Luma(float3 c) {
            return dot(c, float3(0.299, 0.587, 0.114));
        }
    }
    @numthreads(8,8,1)
    entry main(x:u32,y:u32) {
        uint w, h;
        g_LumaOutput.GetDimensions(w, h);
        int2 ipos = int2(x, y);
        if (ipos.x >= int(w) || ipos.y >= int(h)) return;
        float2 uv = (float2(x, y) + 0.5) * inputRcpSize;
        float3 c = g_InputColor.SampleLevel(linearClamp, uv, 0.0).rgb;
        g_LumaOutput[ipos] = Luma(c);
    }
}
