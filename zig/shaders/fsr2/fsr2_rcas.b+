state RCASConstants {
    g_InputColor: int,      // @bind(t, 0, float4)
    g_OutputColor: int,     // @bind(u, 0, float4)
    linearClamp: int,       // @bind(s, 0)
    sharpness: float,
    outputWidth: uint,
    outputHeight: uint,
}

export entry main {
    @numthreads(8, 8, 1)
    for(ix, iy, outputWidth, outputHeight) {
        var texelSize: float2;
        var uv: float2;
        var tapUV: float2;
        var tap: float4;
        var sum: float4;
        var wsum: float4;
        var delta: float2;
        var dist2: float;
        var w: float;
        var result: float4;
        var dy: int;
        var dx: int;

        texelSize = 1.0 / float2(outputWidth, outputHeight);
        uv = (float2(ix, iy) + 0.5) * texelSize;
        sum = 0.0;
        wsum = 0.0;

        for (dy = -1; dy <= 2; ++dy) {
            for (dx = -1; dx <= 2; ++dx) {
                tapUV = saturate(uv + float2(dx, dy) * texelSize);
                tap = g_InputColor.SampleLevel(linearClamp, tapUV, 0.0);
                delta = float2(dx, dy);
                dist2 = dot(delta, delta);
                w = exp(-dist2 * sharpness * 0.25);
                sum = sum + tap * w;
                wsum = wsum + w;
            }
        }

        result = sum / max(wsum, 1e-6);
        *g_OutputColor + (iy * outputWidth + ix) = result;
    }
}