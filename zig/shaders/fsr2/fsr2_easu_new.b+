kernel EASU {
    g_InputColor  : Texture2D<float4> @binding(t0)
    g_OutputColor : RWTexture2D<float4> @binding(u0)
    linearClamp   : SamplerState @binding(s0)
    inputSize     : float2 @cbuffer(0)
    outputSize    : float2 @cbuffer(0)
    inputRcpSize  : float2 @cbuffer(0)
    outputRcpSize : float2 @cbuffer(0)
    globals {
        float3 RcpLuma(float3 c) {
            float l = dot(c, float3(0.299, 0.587, 0.114));
            return c / max(l, 1e-6);
        }
        float4 EASU(float2 p) {
            float2 pp = floor(p);
            float2 fp = p - pp;
            float fx = fp.x;
            float fy = fp.y;
            float2 dir = 0.0;
            float len = 0.0;
            float w1 = (1.0 - fx) * (1.0 - fy);
            float2 uv00 = (float2(-1, -1) + pp) * inputRcpSize;
            float2 uv10 = (float2( 0, -1) + pp) * inputRcpSize;
            float2 uv20 = (float2( 1, -1) + pp) * inputRcpSize;
            float2 uv30 = (float2( 2, -1) + pp) * inputRcpSize;
            float2 uv01 = (float2(-1,  0) + pp) * inputRcpSize;
            float2 uv11 = (float2( 0,  0) + pp) * inputRcpSize;
            float2 uv21 = (float2( 1,  0) + pp) * inputRcpSize;
            float2 uv31 = (float2( 2,  0) + pp) * inputRcpSize;
            float2 uv02 = (float2(-1,  1) + pp) * inputRcpSize;
            float2 uv12 = (float2( 0,  1) + pp) * inputRcpSize;
            float2 uv22 = (float2( 1,  1) + pp) * inputRcpSize;
            float2 uv32 = (float2( 2,  1) + pp) * inputRcpSize;
            float2 uv03 = (float2(-1,  2) + pp) * inputRcpSize;
            float2 uv13 = (float2( 0,  2) + pp) * inputRcpSize;
            float2 uv23 = (float2( 1,  2) + pp) * inputRcpSize;
            float3 a = g_InputColor.SampleLevel(linearClamp, uv00, 0.0).rgb;
            float3 b = g_InputColor.SampleLevel(linearClamp, uv10, 0.0).rgb;
            float3 c = g_InputColor.SampleLevel(linearClamp, uv20, 0.0).rgb;
            float3 d = g_InputColor.SampleLevel(linearClamp, uv30, 0.0).rgb;
            float3 e = g_InputColor.SampleLevel(linearClamp, uv01, 0.0).rgb;
            float3 f = g_InputColor.SampleLevel(linearClamp, uv11, 0.0).rgb;
            float3 g = g_InputColor.SampleLevel(linearClamp, uv21, 0.0).rgb;
            float3 h = g_InputColor.SampleLevel(linearClamp, uv31, 0.0).rgb;
            float3 i = g_InputColor.SampleLevel(linearClamp, uv02, 0.0).rgb;
            float3 j = g_InputColor.SampleLevel(linearClamp, uv12, 0.0).rgb;
            float3 k = g_InputColor.SampleLevel(linearClamp, uv22, 0.0).rgb;
            float3 l = g_InputColor.SampleLevel(linearClamp, uv32, 0.0).rgb;
            float3 m = g_InputColor.SampleLevel(linearClamp, uv03, 0.0).rgb;
            float3 n = g_InputColor.SampleLevel(linearClamp, uv13, 0.0).rgb;
            float3 o = g_InputColor.SampleLevel(linearClamp, uv23, 0.0).rgb;
            {
                float dc = g.x - f.x;
                float cb = f.x - e.x;
                float len_xy = max(abs(dc), abs(cb));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = g.x - e.x;
                dir.x += dir_diff * w1;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w1;
            }
            {
                float ec = j.x - f.x;
                float ca = f.x - b.x;
                float len_xy = max(abs(ec), abs(ca));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = j.x - b.x;
                dir.y += dir_diff * w1;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w1;
            }
            float w2 = fx * (1.0 - fy);
            {
                float dc = h.x - g.x;
                float cb = g.x - f.x;
                float len_xy = max(abs(dc), abs(cb));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = h.x - f.x;
                dir.x += dir_diff * w2;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w2;
            }
            {
                float ec = k.x - g.x;
                float ca = g.x - c.x;
                float len_xy = max(abs(ec), abs(ca));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = k.x - c.x;
                dir.y += dir_diff * w2;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w2;
            }
            float w3 = (1.0 - fx) * fy;
            {
                float dc = k.x - j.x;
                float cb = j.x - i.x;
                float len_xy = max(abs(dc), abs(cb));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = k.x - i.x;
                dir.x += dir_diff * w3;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w3;
            }
            {
                float ec = n.x - j.x;
                float ca = j.x - f.x;
                float len_xy = max(abs(ec), abs(ca));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = n.x - f.x;
                dir.y += dir_diff * w3;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w3;
            }
            float w4 = fx * fy;
            {
                float dc = l.x - k.x;
                float cb = k.x - j.x;
                float len_xy = max(abs(dc), abs(cb));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = l.x - j.x;
                dir.x += dir_diff * w4;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w4;
            }
            {
                float ec = o.x - k.x;
                float ca = k.x - g.x;
                float len_xy = max(abs(ec), abs(ca));
                float rcp_len_xy = 1.0 / max(len_xy, 1e-6);
                float dir_diff = o.x - g.x;
                dir.y += dir_diff * w4;
                len_xy = saturate(abs(dir_diff) * rcp_len_xy);
                len_xy = len_xy * len_xy;
                len += len_xy * w4;
            }
            float dir_len2 = dot(dir, dir);
            if (dir_len2 > 1.0/32768.0) {
                float dir_rcp = rsqrt(dir_len2);
                dir *= dir_rcp;
            } else {
                dir = float2(1.0, 0.0);
            }
            len = len * 0.5;
            len = len * len;
            float stretch = max(abs(dir.x), abs(dir.y));
            float len2_x = 1.0 + (stretch - 1.0) * len;
            float len2_y = 1.0 + (-0.5) * len;
            float lob = 0.5 + (0.21 - 0.5) * len;
            float clp = 1.0 / lob;
            float3 aC = 0.0;
            float aW = 0.0;
            float3 mn = min(min(min(f, g), j), k);
            float3 mx = max(max(max(f, g), j), k);
            [unroll] for (int tap = 0; tap < 16; ++tap) {
                int tx = tap % 4;
                int ty = tap / 4;
                float2 off = float2(float(tx - 1) - fx, float(ty - 1) - fy);
                float2 rot;
                rot.x = off.x * dir.x + off.y * dir.y;
                rot.y = off.x * (-dir.y) + off.y * dir.x;
                rot.x *= len2_x;
                rot.y *= len2_y;
                float d2 = min(dot(rot, rot), clp);
                float wB = 0.4 * d2 - 1.0;
                float wA = lob * d2 - 1.0;
                wB = wB * wB;
                wA = wA * wA;
                wB = 1.5625 * wB - 0.5625;
                float w = wB * wA;
                float3 tapVal;
                if (tx == 0 && ty == 0) tapVal = b;
                else if (tx == 1 && ty == 0) tapVal = c;
                else if (tx == 2 && ty == 0) tapVal = d;
                else if (tx == 3 && ty == 0) tapVal = e;
                else if (tx == 0 && ty == 1) tapVal = f;
                else if (tx == 1 && ty == 1) tapVal = g;
                else if (tx == 2 && ty == 1) tapVal = h;
                else if (tx == 3 && ty == 1) tapVal = i;
                else if (tx == 0 && ty == 2) tapVal = j;
                else if (tx == 1 && ty == 2) tapVal = k;
                else if (tx == 2 && ty == 2) tapVal = l;
                else if (tx == 3 && ty == 2) tapVal = m;
                else if (tx == 0 && ty == 3) tapVal = n;
                else tapVal = o;
                aC = mad(tapVal, w, aC);
                aW = mad(w, 1.0, aW);
            }
            float3 result = aC / max(aW, 1e-6);
            result = clamp(result, mn, mx);
            return float4(result, 1.0);
        }
    }
    @numthreads(8,8,1)
    entry main(x:u32,y:u32) {
        uint outW, outH;
        g_OutputColor.GetDimensions(outW, outH);
        int2 ipos = int2(x, y);
        if (ipos.x >= int(outW) || ipos.y >= int(outH)) return;
        float2 outputPixel = float2(x, y) + 0.5;
        float2 pp = outputPixel * outputSize * inputRcpSize;
        float2 fp = frac(pp);
        float2 p = pp - fp;
        g_OutputColor[ipos] = EASU(pp);
    }
}
