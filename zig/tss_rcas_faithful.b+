entry main {
    var w: i32
    var h: i32
    var src: image<f32>
    var dst: image<f32>
    var x: i32
    var y: i32
    var sharpness: f32
    var c: f32
    var n: f32
    var s: f32
    var e: f32
    var wc: f32
    var cL: f32
    var nL: f32
    var sL: f32
    var eL: f32
    var wL: f32
    var nz: f32
    var nz_range: f32
    var mn4: f32
    var mx4: f32
    var hitMin: f32
    var hitMax: f32
    var lobe_gray: f32
    var lobe: f32
    var rcpL: f32
    var result: f32

    w = 4
    h = 4
    sharpness = 0.5

    create_image(src, w, h)
    create_image(dst, w, h)

    for(x, y, w, h) {
        src[x, y] = x + y
    }

    for(x, y, w, h) {
        c = src[ 0 + x,  0 + y]
        n = src[ 0 + x, -1 + y]
        s = src[ 0 + x,  1 + y]
        e = src[ 1 + x,  0 + y]
        wc = src[-1 + x,  0 + y]

        // Luma*2: for grayscale, pixel*2
        cL = c + c
        nL = n + n
        sL = s + s
        eL = e + e
        wL = wc + wc

        // Noise detection: highpass (b+d+f+h)*0.25 - e
        nz = 0.25 * nL + 0.25 * wL + 0.25 * eL + 0.25 * sL - cL
        nz_range = max(max(max(nL, wL), cL), max(eL, sL)) - min(min(min(nL, wL), cL), min(eL, sL))
        nz = abs(nz) / nz_range
        nz = saturate(nz)
        nz = -0.5 * nz + 1.0

        // Min/max of ring (4 cardinal neighbors)
        mn4 = min(min(n, wc), min(e, s))
        mx4 = max(max(n, wc), max(e, s))

        // Limiters
        hitMin = min(mn4, c) / (4.0 * mx4)
        hitMax = (1.0 - max(mx4, c)) / (4.0 * mn4 - 4.0)

        // Lobe = max(-hitMin, hitMax), clamped to [-0.1875, 0]
        lobe_gray = max(0.0 - hitMin, hitMax)
        lobe = max(-0.1875, min(lobe_gray, 0.0))
        lobe = lobe * sharpness

        // Denoise
        lobe = lobe * nz

        // Resolve
        rcpL = 1.0 / (4.0 * lobe + 1.0)
        result = (lobe * n + lobe * wc + lobe * s + lobe * e + c) * rcpL
        dst[x, y] = result
    }
    print("ok")
}
