extern fn print_i64(x: i64);

struct Point { x: i64, y: i64 }

fn main() {
    // var y; (without type or init)
    var y;
    y = 42;
    print_i64(y);

    // var z = 10 (type inference)
    var z = 10;
    print_i64(z);

    // pointer write
    var x: i64 = 5;
    var p: *i64 = &x;
    *p = 99;
    print_i64(x);

    // if without parens
    if x > 0 {
        print_i64(1);
    }

    // while without parens
    while z > 0 {
        z -= 1;
    }
    print_i64(z);
}
