state S {
    fn_ptr: int64,
}

export entry init {
    fn_ptr = LoadLibraryA("C:\Windows\System32\kernel32.dll\0");
    ret 0;
}

export entry caller {
    // Test: call_indirect with @arg(0) as argument
    // @arg(0) = saved RCX which is the 'this' pointer
    // For a simple test, just verify it compiles
    let this = @arg(0);
    ret this;
}
