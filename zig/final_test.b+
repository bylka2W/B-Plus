context {
    int tick = 0;
    int score = 0;
    int health = 100;
    int level = 1;
    int enemies = 5;
}

state Boot @Cache(L1) {
    var x : int32 @Cache(L1)
    var y : int32 @Cache(L1)
    entry {
        print("BOOT\n")
        x = 10
        y = 20
        score = 0
        health = 100
        level = 1
        tick = 0
        enemies = 5
    }
    always -> Init
}

state Init @Cache(L1) {
    var data : int32 @Cache(L1)
    entry {
        print("INIT\n")
        data = 42
        tick = tick + 1
    }
    on 's' -> Spawn
    on 'a' -> Attack
    on 'h' -> Heal
    always -> Init
}

state Spawn @Cache(L2) {
    var enemy_hp : int32 @Cache(L1)
    entry {
        print("SPAWN\n")
        enemy_hp = 50
        enemies = enemies + 1
        tick = tick + 1
    }
    always -> Init
}

state Attack @Cache(L2) {
    var damage : int32 @Cache(L1)
    entry {
        print("ATTACK\n")
        damage = 25
        enemies = enemies - 1
        score = score + 10
        tick = tick + 1
    }
    always -> Init
}

state Heal @Cache(L1) {
    var amount : int32 @Cache(L1)
    entry {
        print("HEAL\n")
        amount = 20
        health = health + amount
        tick = tick + 1
    }
    always -> Init
}

state LevelUp @Cache(L1) {
    var bonus : int32 @Cache(L1)
    entry {
        print("LEVELUP\n")
        bonus = 100
        level = level + 1
        score = score + bonus
        enemies = 5
        tick = tick + 1
    }
    always -> Init
}

state GameOver {
    entry {
        print("GAMEOVER\n")
    }
    on 'r' -> Boot
    always -> GameOver
}