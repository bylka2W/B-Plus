state DXGI {
    real_dxgi: int64,
    fn1: int64,
    fn2: int64,
    factory: int64,
    out_addr: int64,
    hr: int64,
    orig_vtbl: int64,
    new_vtbl: int64,
    i: int64,
    entry13: int64,
}

export entry A {
    if (*(real_dxgi) == 0) {
        *(real_dxgi) = LoadLibraryA("C:\\Windows\\System32\\dxgi.dll\0");
        *(fn1) = GetProcAddress(*(real_dxgi), "CreateDXGIFactory\0");
        *(fn2) = GetProcAddress(*(real_dxgi), "CreateDXGIFactory1\0");
    }
    factory = 0;
    out_addr = addr(factory);
    hr = call_indirect(*(fn1), addr(factory), out_addr);
    if (hr < 0) { ret hr; }
    orig_vtbl = ptr_load(factory);
    new_vtbl = HeapAlloc(GetProcessHeap(), 8, 96);
    i = 0;
    for (12, 1) {
        let entry = ptr_load(orig_vtbl + x * 8);
        ptr_store(new_vtbl + x * 8, entry);
        x = x + 1;
    }
    ptr_store(new_vtbl + 10 * 8, 0x1234);
    entry13 = ptr_load(orig_vtbl + 13 * 8);
    if (entry13 != 0) {
        ptr_store(new_vtbl + 13 * 8, 0x5678);
    }
    ret 0;
}

export entry B {
    if (*(real_dxgi) == 0) {
        *(real_dxgi) = LoadLibraryA("C:\\Windows\\System32\\dxgi.dll\0");
        *(fn1) = GetProcAddress(*(real_dxgi), "CreateDXGIFactory\0");
        *(fn2) = GetProcAddress(*(real_dxgi), "CreateDXGIFactory1\0");
    }
    factory = 0;
    out_addr = addr(factory);
    hr = call_indirect(*(fn2), addr(factory), out_addr);
    if (hr < 0) { ret hr; }
    orig_vtbl = ptr_load(factory);
    new_vtbl = HeapAlloc(GetProcessHeap(), 8, 104);
    i = 0;
    for (12, 1) {
        let entry = ptr_load(orig_vtbl + x * 8);
        ptr_store(new_vtbl + x * 8, entry);
        x = x + 1;
    }
    ptr_store(new_vtbl + 10 * 8, 0x1234);
    entry13 = ptr_load(orig_vtbl + 13 * 8);
    if (entry13 != 0) {
        ptr_store(new_vtbl + 13 * 8, 0x5678);
    }
    ret 0;
}
