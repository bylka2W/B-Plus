state S1 {
    var img: image<f32>
    var val: f32
    enter {
        create_image(img, 4, 4)
        img[0, 0] = 1.0
        img[1, 0] = 2.0
        img[0, 1] = 3.0
        img[1, 1] = 4.0
        val = sample(img, 0.5, 0.5)
        if (val) { print("ok"); } else { print("FAIL"); }
    }
    always -> S1
}

entry main {
    always { }
}
