state d3d {
    feature_level: int64,
    device: int64,
    context: int64,
    hr: int64
}

entry main {
    let d3d11 = LoadLibraryA("d3d11.dll");
    let D3D11CreateDevice = GetProcAddress(d3d11, "D3D11CreateDevice");
    // Set feature level to D3D_FEATURE_LEVEL_11_0 = 0xb000
    let feature_level = 0xb000;
    feature_level = feature_level;
    // HRESULT D3D11CreateDevice(
    //   IDXGIAdapter* pAdapter,         RCX = 0 (NULL)
    //   D3D_DRIVER_TYPE DriverType,     RDX = 1 (D3D_DRIVER_TYPE_HARDWARE)
    //   HMODULE Software,               R8  = 0 (NULL)
    //   UINT Flags,                     R9  = 0
    //   D3D_FEATURE_LEVEL* pFLs,        [RSP+0x20] = addr(feature_level)
    //   UINT NumFLs,                    [RSP+0x28] = 1
    //   UINT SDKVersion,                [RSP+0x30] = 7 (D3D11_SDK_VERSION)
    //   ID3D11Device** ppDevice,        [RSP+0x38] = addr(device)
    //   D3D_FEATURE_LEVEL* pFLOut,      [RSP+0x40] = 0 (NULL)
    //   ID3D11DeviceContext** ppCtx     [RSP+0x48] = addr(context)
    // )
    let hr = call_indirect(D3D11CreateDevice,
        0, 1, 0, 0,
        addr(feature_level), 1, 7,
        addr(device), 0, addr(context));
    hr = hr;
}
