state D3D11 {
    var factory: i64
    var swapchain: i64
    var orig_vtbl: i64
    var hook_vtbl: i64
    var cso_data: i64
    var cso_size: i32
    var cso: i64
    var device: i64
    var ctx: i64
    var uav: i64
}

entry main {
    var handler = @entry_addr("OnPresent");
    var heap = call_indirect(GetProcessHeap);
    var vtbl = call_indirect(HeapAlloc, heap, 8, 160);
    *(vtbl + 0) = handler; *(vtbl + 8) = handler; *(vtbl + 16) = handler;
    *(vtbl + 24) = handler; *(vtbl + 32) = handler; *(vtbl + 40) = handler;
    *(vtbl + 48) = handler; *(vtbl + 56) = handler; *(vtbl + 64) = handler;
    *(vtbl + 72) = handler; *(vtbl + 80) = handler; *(vtbl + 88) = handler;
    *(vtbl + 96) = handler; *(vtbl + 104) = handler; *(vtbl + 112) = handler;
    *(vtbl + 120) = handler; *(vtbl + 128) = handler; *(vtbl + 136) = handler;
    *(vtbl + 144) = handler; *(vtbl + 152) = handler;
    var readback = *(vtbl + 64);
    if (readback != handler) {
        call_indirect(ExitProcess, 2);
    }
    if (handler == 0) {
        call_indirect(ExitProcess, 1);
    }
    call_indirect(ExitProcess, 0);
}

export entry OnPresent {
    ret 0;
}
