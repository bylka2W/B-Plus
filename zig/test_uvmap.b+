state S1 {
    var src: image<f32>
    var dst: image<f32>
    var val: f32
    var u: f32
    var v: f32
    enter {
        create_image(src, 4, 4)
        create_image(dst, 8, 8)
        src[0, 0] = 1.0
        src[1, 0] = 2.0
        src[2, 0] = 3.0
        src[3, 0] = 4.0
        src[0, 1] = 5.0
        src[1, 1] = 6.0
        src[2, 1] = 7.0
        src[3, 1] = 8.0
        src[0, 2] = 9.0
        src[1, 2] = 10.0
        src[2, 2] = 11.0
        src[3, 2] = 12.0
        src[0, 3] = 13.0
        src[1, 3] = 14.0
        src[2, 3] = 15.0
        src[3, 3] = 16.0
        for(x, y, 8, 8) {
            u = (x + 0.5) / 2.0 - 0.5
            v = (y + 0.5) / 2.0 - 0.5
            val = sample(src, u, v)
            dst[x, y] = val
        }
        print("ok")
    }
    always -> S1
}

entry main {
    always { }
}
