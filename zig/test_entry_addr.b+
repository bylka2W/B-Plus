entry main {
    var p = @entry_addr("Init");
    var p2 = @entry_addr("main");
    call_indirect(LoadLibraryA, "user32.dll");
    call_indirect(GetProcAddress, rax, "MessageBoxA");
    call_indirect(rax, 0, "entry_addr works!\0", "B+ Test\0", 0);
    call_indirect(ExitProcess, 0);
}
export entry Init {
    ret 0;
}
