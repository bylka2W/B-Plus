state S1 {
    var img: image<f32>
    var v0: f32
    var v1: f32
    var v2: f32
    enter {
        create_image(img, 2, 2)
        img[0,0] = 0
        img[1,0] = 10
        img[0,1] = 20
        img[1,1] = 30
        v0 = sample(img, 0.5, 0.5)
        if (v0) { print("C") } else { print("c") }
        v1 = sample(img, -100.0, -100.0)
        if (v1) { print("N") } else { print("Z") }
        v2 = sample(img, 1000.0, 1000.0)
        if (v2) { print("P") } else { print("p") }
    }
    always -> S1
}

entry main {
    always { }
}
