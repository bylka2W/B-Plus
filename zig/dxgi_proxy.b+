    ptr_store(new_vtbl + 48, entry);
    entry = ptr_load(orig_vtbl + 56);
    ptr_store(new_vtbl + 56, entry);
    entry = ptr_load(orig_vtbl + 64);
    ptr_store(new_vtbl + 64, entry);
    entry = ptr_load(orig_vtbl + 72);
    ptr_store(new_vtbl + 72, entry);
    entry = ptr_load(orig_vtbl + 80);
    ptr_store(new_vtbl + 80, entry);
    entry = ptr_load(orig_vtbl + 88);
    ptr_store(new_vtbl + 88, entry);
    entry = ptr_load(orig_vtbl + 96);
    ptr_store(new_vtbl + 96, entry);
    entry = ptr_load(orig_vtbl + 104);
    ptr_store(new_vtbl + 104, entry);
    entry = ptr_load(orig_vtbl + 112);
    ptr_store(new_vtbl + 112, entry);
    entry = ptr_load(orig_vtbl + 120);
    ptr_store(new_vtbl + 120, entry);
    entry = ptr_load(orig_vtbl + 128);
    ptr_store(new_vtbl + 128, entry);
    entry = ptr_load(orig_vtbl + 136);
    ptr_store(new_vtbl + 136, entry);
    entry = ptr_load(orig_vtbl + 144);
    ptr_store(new_vtbl + 144, entry);
    entry = ptr_load(orig_vtbl + 152);
    ptr_store(new_vtbl + 152, entry);
    entry = ptr_load(orig_vtbl + 160);
