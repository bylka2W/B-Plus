state DXGI {
    real_dxgi,
    real_CreateDXGIFactory,
    real_CreateDXGIFactory1,
    real_CreateDXGIFactory2,
    orig_CreateSwapChain,
    orig_CreateSwapChainForHwnd,
    factory,
    hr,
    orig_vtbl,
    new_vtbl,
    entry13,
    out_addr,
    swapchain,
    sw_orig_vtbl,
    sw_new_vtbl,
    orig_present,
    entry,
    cso_data,
    cso_size,
    init_done,
    file,
    size_hi,
    size_lo,
    buf,
    read,
    device,
    context,
    compute_shader,
    backbuffer,
    guid_buf,
    fn_ptr,
    buf_addr,
    width,
    height,
}

export entry CreateDXGIFactory {
    if (real_dxgi == 0) {
        real_dxgi = LoadLibraryA("C:\\Windows\\System32\\dxgi.dll\0");
        real_CreateDXGIFactory = GetProcAddress(real_dxgi, "CreateDXGIFactory\0");
        real_CreateDXGIFactory1 = GetProcAddress(real_dxgi, "CreateDXGIFactory1\0");
        real_CreateDXGIFactory2 = GetProcAddress(real_dxgi, "CreateDXGIFactory2\0");
    }
    factory = 0;
    out_addr = addr(factory);
    hr = call_indirect(real_CreateDXGIFactory, addr(factory), out_addr);
    if (hr < 0) { ret hr; }
    orig_vtbl = ptr_load(factory);
    new_vtbl = HeapAlloc(GetProcessHeap(), 8, 120);
    entry = ptr_load(orig_vtbl);
    ptr_store(new_vtbl, entry);
    entry = ptr_load(orig_vtbl + 8);
    ptr_store(new_vtbl + 8, entry);
    entry = ptr_load(orig_vtbl + 16);
    ptr_store(new_vtbl + 16, entry);
    entry = ptr_load(orig_vtbl + 24);
    ptr_store(new_vtbl + 24, entry);
    entry = ptr_load(orig_vtbl + 32);
    ptr_store(new_vtbl + 32, entry);
    entry = ptr_load(orig_vtbl + 40);
    ptr_store(new_vtbl + 40, entry);
    entry = ptr_load(orig_vtbl + 48);
    ptr_store(new_vtbl + 48, entry);
    entry = ptr_load(orig_vtbl + 56);
    ptr_store(new_vtbl + 56, entry);
    entry = ptr_load(orig_vtbl + 64);
    ptr_store(new_vtbl + 64, entry);
    entry = ptr_load(orig_vtbl + 72);
    ptr_store(new_vtbl + 72, entry);
    entry = ptr_load(orig_vtbl + 80);
    ptr_store(new_vtbl + 80, entry);
    entry = ptr_load(orig_vtbl + 88);
    ptr_store(new_vtbl + 88, entry);
    entry = ptr_load(orig_vtbl + 96);
    ptr_store(new_vtbl + 96, entry);
    entry = ptr_load(orig_vtbl + 104);
    ptr_store(new_vtbl + 104, entry);
    orig_CreateSwapChain = ptr_load(orig_vtbl + 80);
    ptr_store(new_vtbl + 80, @entry_addr("OnCreateSwapChain"));
    entry13 = ptr_load(orig_vtbl + 104);
    if (entry13 != 0) {
        orig_CreateSwapChainForHwnd = ptr_load(orig_vtbl + 104);
        ptr_store(new_vtbl + 104, @entry_addr("OnCreateSwapChainForHwnd"));
    }
    ptr_store(factory, new_vtbl);
    ret hr;
}

