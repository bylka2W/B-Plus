state A { entry { print("A") } always -> B }
state B { entry { print("B") } always -> C }
state C { entry { print("C") } always -> D }
state D { entry { print("D") } always -> E }
state E { entry { print("E") } always -> F }
state F { entry { print("F") } always -> G }
state G { entry { print("G") } always -> H }
state H { entry { print("H") } always -> A }
