entry main {
    var iw: i32
    var ih: i32
    var ow: i32
    var oh: i32
    var src: image<f32>
    var dst: image<f32>
    var x: i32
    var y: i32
    var pp_x: f32
    var pp_y: f32
    var fp_x: f32
    var fp_y: f32
    var fx: f32
    var fy: f32
    var b: f32
    var c: f32
    var e: f32
    var f: f32
    var g: f32
    var h: f32
    var i: f32
    var j: f32
    var k: f32
    var l: f32
    var n: f32
    var o: f32
    var dir_x: f32
    var dir_y: f32
    var len_val: f32
    var w1: f32
    var w2: f32
    var w3: f32
    var w4: f32
    var dc: f32
    var cb: f32
    var len_xy: f32
    var rcp_len_xy: f32
    var dir_diff: f32
    var ec: f32
    var ca: f32
    var dir_len2: f32
    var dir_rcp: f32
    var stretch: f32
    var len2_x: f32
    var len2_y: f32
    var lob: f32
    var clp: f32
    var mn: f32
    var mx: f32
    var aC: f32
    var aW: f32
    var off_x: f32
    var off_y: f32
    var rot_x: f32
    var rot_y: f32
    var d2: f32
    var wB: f32
    var wA: f32
    var w: f32
    var tap_val: f32
    var result: f32

    iw = 4
    ih = 4
    ow = iw * 2
    oh = ih * 2

    create_image(src, iw, ih)
    create_image(dst, ow, oh)

    for(x, y, iw, ih) {
        src[x, y] = x + y
    }

    for(x, y, ow, oh) {
        pp_x = x * 0.5
        pp_y = y * 0.5

        fp_x = floor(pp_x)
        fp_y = floor(pp_y)

        fx = pp_x - fp_x
        fy = pp_y - fp_y

        b = src[ 0 + fp_x, -1 + fp_y]
        c = src[ 1 + fp_x, -1 + fp_y]
        e = src[-1 + fp_x,  0 + fp_y]
        f = src[ 0 + fp_x,  0 + fp_y]
        g = src[ 1 + fp_x,  0 + fp_y]
        h = src[ 2 + fp_x,  0 + fp_y]
        i = src[-1 + fp_x,  1 + fp_y]
        j = src[ 0 + fp_x,  1 + fp_y]
        k = src[ 1 + fp_x,  1 + fp_y]
        l = src[ 2 + fp_x,  1 + fp_y]
        n = src[ 0 + fp_x,  2 + fp_y]
        o = src[ 1 + fp_x,  2 + fp_y]

        dir_x = 0.0
        dir_y = 0.0
        len_val = 0.0

        w1 = (1.0 - fx) * (1.0 - fy)

        dc = g - f
        cb = f - e
        len_xy = max(abs(dc), abs(cb))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = g - e
        dir_x = dir_x + dir_diff * w1
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w1

        ec = j - f
        ca = f - b
        len_xy = max(abs(ec), abs(ca))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = j - b
        dir_y = dir_y + dir_diff * w1
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w1

        w2 = fx * (1.0 - fy)

        dc = h - g
        cb = g - f
        len_xy = max(abs(dc), abs(cb))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = h - f
        dir_x = dir_x + dir_diff * w2
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w2

        ec = k - g
        ca = g - c
        len_xy = max(abs(ec), abs(ca))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = k - c
        dir_y = dir_y + dir_diff * w2
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w2

        w3 = (1.0 - fx) * fy

        dc = k - j
        cb = j - i
        len_xy = max(abs(dc), abs(cb))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = k - i
        dir_x = dir_x + dir_diff * w3
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w3

        ec = n - j
        ca = j - f
        len_xy = max(abs(ec), abs(ca))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = n - f
        dir_y = dir_y + dir_diff * w3
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w3

        w4 = fx * fy

        dc = l - k
        cb = k - j
        len_xy = max(abs(dc), abs(cb))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = l - j
        dir_x = dir_x + dir_diff * w4
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w4

        ec = o - k
        ca = k - g
        len_xy = max(abs(ec), abs(ca))
        rcp_len_xy = 1.0 / len_xy
        dir_diff = o - g
        dir_y = dir_y + dir_diff * w4
        len_xy = saturate(abs(dir_diff) * rcp_len_xy)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w4

        dir_len2 = dir_x * dir_x + dir_y * dir_y
        if (max(dir_len2 - (1.0 / 32768.0), 0.0)) {
            dir_rcp = rsqrt(dir_len2)
            dir_x = dir_x * dir_rcp
            dir_y = dir_y * dir_rcp
        } else {
            dir_x = 1.0
            dir_y = 0.0
        }

        len_val = len_val * 0.5
        len_val = len_val * len_val
        stretch = (dir_x * dir_x + dir_y * dir_y) / max(abs(dir_x), abs(dir_y))
        len2_x = 1.0 + (stretch - 1.0) * len_val
        len2_y = 1.0 + (-0.5) * len_val
        lob = 0.5 + (0.21 - 0.5) * len_val
        clp = 1.0 / lob

        mn = min(min(min(f, g), j), k)
        mx = max(max(max(f, g), j), k)

        aC = 0.0
        aW = 0.0

        off_x = 0.0 - fx
        off_y = -1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = b
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 1.0 - fx
        off_y = -1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = c
        aC = aC + tap_val * w
        aW = aW + w

        off_x = -1.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = e
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 0.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = f
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 1.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = g
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 2.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = h
        aC = aC + tap_val * w
        aW = aW + w

        off_x = -1.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = i
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 0.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = j
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 1.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = k
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 2.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = l
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 0.0 - fx
        off_y = 2.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = n
        aC = aC + tap_val * w
        aW = aW + w

        off_x = 1.0 - fx
        off_y = 2.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        tap_val = o
        aC = aC + tap_val * w
        aW = aW + w

        result = aC / aW
        result = max(mn, result)
        result = min(mx, result)
        dst[x, y] = result
    }
    print("ok")
}
