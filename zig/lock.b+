state Locked { entry { print("--- LOCKED. Enter o or w ---\n") } on "o" -> Opened on "w" -> Attempt1 } state Attempt1 { entry { print("Wrong! [1/3]. Enter o or w\n") } on "o" -> Opened on "w" -> Attempt2 } state Attempt2 { entry { print("Wrong! [2/3]. Enter o or w\n") } on "o" -> Opened on "w" -> Alarm } state Opened { entry { print("=== OPENED ===\n") } on "l" -> Locked } state Alarm { entry { print("🚨 ALARM! Enter r:\n") } on "r" -> Locked }