struct RESOURCE_BARRIER { Type: int, Flags: int, pResource: int, Subresource: int, StateBefore: int, StateAfter: int }

state Work {
    var barrier: RESOURCE_BARRIER = 0
    enter {
        barrier.Type = 0
        barrier.Flags = 0
        barrier.StateBefore = 10
        barrier.StateAfter = 11
        return -> barrier.StateAfter
    }
    always -> Work
}

entry main {
    always { }
}
