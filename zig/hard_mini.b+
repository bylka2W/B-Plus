state Init @Cache(L1) {
    var x : int32 @Cache(L1)
    entry { print("INIT\n"); x = 10 }
    always -> Process
}
state Process @Cache(L2) {
    var buf : byte @Cache(L1)
    entry { print("PROCESS\n"); buf = 0 }
    always -> Validate
}
state Validate @Cache(L1) {
    var data : int32 @Cache(L1)
    entry { print("VALIDATE\n"); data = 42 }
    always -> Final
}
state Final {
    entry { print("FINAL\n") }
    always -> Init
}
