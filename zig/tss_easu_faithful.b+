entry main {
    var iw: i32
    var ih: i32
    var ow: i32
    var oh: i32
    var src: image<f32>
    var dst: image<f32>
    var ox: i32
    var oy: i32
    var pp_x: f32
    var pp_y: f32
    var fp_x: f32
    var fp_y: f32
    var fx: f32
    var fy: f32
    var b: f32
    var c: f32
    var e: f32
    var f: f32
    var g: f32
    var h: f32
    var ii: f32
    var j: f32
    var k: f32
    var l: f32
    var n: f32
    var o: f32
    var bL: f32
    var cL: f32
    var eL: f32
    var fL: f32
    var gL: f32
    var hL: f32
    var iL: f32
    var jL: f32
    var kL: f32
    var lL: f32
    var nL: f32
    var oL: f32
    var dir_x: f32
    var dir_y: f32
    var len_val: f32
    var w: f32
    var dc: f32
    var cb: f32
    var len_xy: f32
    var rcp_len: f32
    var dir_diff: f32
    var ec: f32
    var ca: f32
    var dir_len2: f32
    var dir_rcp: f32
    var zro: f32
    var stretch: f32
    var len2_x: f32
    var len2_y: f32
    var lob: f32
    var clp: f32
    var mn: f32
    var mx: f32
    var aC: f32
    var aW: f32
    var off_x: f32
    var off_y: f32
    var rot_x: f32
    var rot_y: f32
    var d2: f32
    var wB: f32
    var wA: f32
    var result: f32

    iw = 4
    ih = 4
    ow = iw * 2
    oh = ih * 2

    create_image(src, iw, ih)
    create_image(dst, ow, oh)

    for(ox, oy, iw, ih) {
        src[ox, oy] = ox + oy
    }

    for(ox, oy, ow, oh) {
        pp_x = ox * 0.5 + (-0.25)
        pp_y = oy * 0.5 + (-0.25)
        fp_x = floor(pp_x)
        fp_y = floor(pp_y)
        fx = pp_x - fp_x
        fy = pp_y - fp_y

        b = src[ 0 + fp_x, -1 + fp_y]
        c = src[ 1 + fp_x, -1 + fp_y]
        e = src[-1 + fp_x,  0 + fp_y]
        f = src[ 0 + fp_x,  0 + fp_y]
        g = src[ 1 + fp_x,  0 + fp_y]
        h = src[ 2 + fp_x,  0 + fp_y]
        ii = src[-1 + fp_x,  1 + fp_y]
        j = src[ 0 + fp_x,  1 + fp_y]
        k = src[ 1 + fp_x,  1 + fp_y]
        l = src[ 2 + fp_x,  1 + fp_y]
        n = src[ 0 + fp_x,  2 + fp_y]
        o = src[ 1 + fp_x,  2 + fp_y]

        // Luma*2 for grayscale (= pixel * 2)
        bL = b + b
        cL = c + c
        eL = e + e
        fL = f + f
        gL = g + g
        hL = h + h
        iL = ii + ii
        jL = j + j
        kL = k + k
        lL = l + l
        nL = n + n
        oL = o + o

        dir_x = 0.0
        dir_y = 0.0
        len_val = 0.0

        // FsrEasuSetF(dir,len,pp, true, false,false,false, bL,eL,fL,gL,jL)
        w = (1.0 - fx) * (1.0 - fy)
        dc = gL - fL
        cb = fL - eL
        len_xy = max(abs(dc), abs(cb))
        rcp_len = 1.0 / len_xy
        dir_diff = gL - eL
        dir_x = dir_x + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w
        ec = jL - fL
        ca = fL - bL
        len_xy = max(abs(ec), abs(ca))
        rcp_len = 1.0 / len_xy
        dir_diff = jL - bL
        dir_y = dir_y + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w

        // FsrEasuSetF(dir,len,pp, false,true ,false,false, cL,fL,gL,hL,kL)
        w = fx * (1.0 - fy)
        dc = hL - gL
        cb = gL - fL
        len_xy = max(abs(dc), abs(cb))
        rcp_len = 1.0 / len_xy
        dir_diff = hL - fL
        dir_x = dir_x + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w
        ec = kL - gL
        ca = gL - cL
        len_xy = max(abs(ec), abs(ca))
        rcp_len = 1.0 / len_xy
        dir_diff = kL - cL
        dir_y = dir_y + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w

        // FsrEasuSetF(dir,len,pp, false,false,true ,false, fL,iL,jL,kL,nL)
        w = (1.0 - fx) * fy
        dc = kL - jL
        cb = jL - iL
        len_xy = max(abs(dc), abs(cb))
        rcp_len = 1.0 / len_xy
        dir_diff = kL - iL
        dir_x = dir_x + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w
        ec = nL - jL
        ca = jL - fL
        len_xy = max(abs(ec), abs(ca))
        rcp_len = 1.0 / len_xy
        dir_diff = nL - fL
        dir_y = dir_y + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w

        // FsrEasuSetF(dir,len,pp, false,false,false,true , gL,jL,kL,lL,oL)
        w = fx * fy
        dc = lL - kL
        cb = kL - jL
        len_xy = max(abs(dc), abs(cb))
        rcp_len = 1.0 / len_xy
        dir_diff = lL - jL
        dir_x = dir_x + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w
        ec = oL - kL
        ca = kL - gL
        len_xy = max(abs(ec), abs(ca))
        rcp_len = 1.0 / len_xy
        dir_diff = oL - gL
        dir_y = dir_y + dir_diff * w
        len_xy = saturate(abs(dir_diff) * rcp_len)
        len_xy = len_xy * len_xy
        len_val = len_val + len_xy * w

        // Normalize direction with degenerate guard
        dir_len2 = dir_x * dir_x + dir_y * dir_y
        zro = max(dir_len2 - (1.0 / 32768.0), 0.0)
        if (zro) {
            dir_rcp = rsqrt(dir_len2)
            dir_x = dir_x * dir_rcp
            dir_y = dir_y * dir_rcp
        } else {
            dir_x = 1.0
            dir_y = 0.0
        }

        // len = len * 0.5; len *= len
        len_val = len_val * 0.5
        len_val = len_val * len_val

        // stretch = (dir.x^2 + dir.y^2) * rcp(max(abs(dir.x), abs(dir.y)))
        stretch = (dir_x * dir_x + dir_y * dir_y) / max(abs(dir_x), abs(dir_y))

        // len2 = (1 + (stretch-1)*len, 1 + (-0.5)*len)
        len2_x = 1.0 + (stretch - 1.0) * len_val
        len2_y = 1.0 + (-0.5) * len_val

        // lob = 0.5 + ((1/4 - 0.04) - 0.5) * len
        lob = 0.5 + (0.21 - 0.5) * len_val

        // clp = rcp(lob)
        clp = 1.0 / lob

        // Min/max of 4 nearest (f, g, j, k)
        mn = min(min(min(f, g), j), k)
        mx = max(max(max(f, g), j), k)

        // Accumulate 12 taps
        aC = 0.0
        aW = 0.0

        // b: offset (0, -1) - pp
        off_x = 0.0 - fx
        off_y = -1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + b * w
        aW = aW + w

        // c: offset (1, -1) - pp
        off_x = 1.0 - fx
        off_y = -1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + c * w
        aW = aW + w

        // i: offset (-1, 1) - pp
        off_x = -1.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + ii * w
        aW = aW + w

        // j: offset (0, 1) - pp
        off_x = 0.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + j * w
        aW = aW + w

        // f: offset (0, 0) - pp
        off_x = 0.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + f * w
        aW = aW + w

        // e: offset (-1, 0) - pp
        off_x = -1.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + e * w
        aW = aW + w

        // k: offset (1, 1) - pp
        off_x = 1.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + k * w
        aW = aW + w

        // l: offset (2, 1) - pp
        off_x = 2.0 - fx
        off_y = 1.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + l * w
        aW = aW + w

        // h: offset (2, 0) - pp
        off_x = 2.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + h * w
        aW = aW + w

        // g: offset (1, 0) - pp
        off_x = 1.0 - fx
        off_y = 0.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + g * w
        aW = aW + w

        // o: offset (1, 2) - pp
        off_x = 1.0 - fx
        off_y = 2.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + o * w
        aW = aW + w

        // n: offset (0, 2) - pp
        off_x = 0.0 - fx
        off_y = 2.0 - fy
        rot_x = off_x * dir_x + off_y * dir_y
        rot_y = off_x * (0.0 - dir_y) + off_y * dir_x
        rot_x = rot_x * len2_x
        rot_y = rot_y * len2_y
        d2 = rot_x * rot_x + rot_y * rot_y
        d2 = min(d2, clp)
        wB = 0.4 * d2 - 1.0
        wA = lob * d2 - 1.0
        wB = wB * wB
        wA = wA * wA
        wB = 1.5625 * wB - 0.5625
        w = wB * wA
        aC = aC + n * w
        aW = aW + w

        // Normalize and clamp
        result = aC / aW
        result = max(mn, result)
        result = min(mx, result)
        dst[ox, oy] = result
    }
    print("ok")
}
