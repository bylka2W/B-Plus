<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BPlus.Cli</RootNamespace>
    <AssemblyName>bpc</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="glslangValidator.exe" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPlus.Core\BPlus.Core.csproj" />
    <ProjectReference Include="..\BPlus.Targets\BPlus.Targets.csproj" />
    <ProjectReference Include="..\BPlus.Runtime\BPlus.Runtime.csproj" />
    <ProjectReference Include="..\BPlus.Native\BPlus.Native.csproj" />
    <ProjectReference Include="..\BPlus.Shader\BPlus.Shader.csproj" />
    <ProjectReference Include="..\BPlus.Tooling\BPlus.Tooling.csproj" />
    <ProjectReference Include="..\BPlus.Lsp\BPlus.Lsp.csproj" />
    <ProjectReference Include="..\BPlus.Debugger\BPlus.Debugger.csproj" />
  </ItemGroup>
</Project>
