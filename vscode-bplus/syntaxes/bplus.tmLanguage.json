{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B+",
  "scopeName": "source.bplus",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bplus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bplus",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "comment.block.bplus" }
          }
        },
        {
          "name": "comment.line.hash.bplus",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bplus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bplus",
              "match": "\\\\[nrt\\\\\"'0]"
            }
          ]
        },
        {
          "name": "string.quoted.single.bplus",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bplus",
              "match": "\\\\[nrt\\\\\"'0]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hex.bplus",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.bplus",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.bplus",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.bplus",
          "match": "\\b\\d+_\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.bplus",
          "match": "\\b\\d*\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\d+\\.\\d*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.bplus",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bplus",
          "match": "\\b(if|else|while|for|in|loop|match|break|continue|return|tern|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.bplus",
          "match": "\\b(fn|let|var|const|mut|struct|enum|trait|impl|type|import|export|from|as|pub|priv|static|extern|self|this|super|defer|errdefer|orelse|catch|try|and|or|not|async|await|yield|atomic|volatile|state|entry|on|always|parallel|fire|machine|kernel|pipeline|forward|run|print|free|body|step|publish|enter|exit|owned|borrowed|use|metal|cxx|comptime|inline|noinline|unreachable|panic|sizeof|alignof|typeof|ref|deref)\\b"
        },
        {
          "name": "constant.language.bplus",
          "match": "\\b(true|false|null|void|any)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.bplus",
          "match": "\\b(u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f16|f32|f64|f80|f128|bool|char|string|cstring|void|any|null|i8_t|u8_t)\\b"
        },
        {
          "name": "entity.name.type.bplus",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.bplus",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "support.function.bplus",
          "match": "\\b(print|println|printf|assert|sizeof|len|array_len|string_len)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.bplus",
          "match": "\\+\\+|--|-=|\\+=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|[-+*/%]|>>|<<|\\||\\^|&|~|!"
        },
        {
          "name": "keyword.operator.comparison.bplus",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.bplus",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.ternary.bplus",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arrow.bplus",
          "match": "=>|->|\\.\\.|::"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.group.bplus",
          "match": "[\\(\\)\\[\\]\\{\\}]"
        },
        {
          "name": "punctuation.separator.bplus",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.bplus",
          "match": "\\."
        }
      ]
    }
  }
}