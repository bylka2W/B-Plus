{
  "name": "vscode-bplus",
  "displayName": "B+ Language Support",
  "description": "Syntax highlighting, snippets and Run integration for the B+ programming language. Bundles the bpc.exe compiler — write code and run it, nothing else to install.",
  "version": "0.2.0",
  "publisher": "bplus",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bylka2W/B-Plus.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "b+",
    "bplus",
    "language",
    "compiler"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:bplus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bplus",
        "aliases": [
          "B+",
          "bplus",
          "b+"
        ],
        "extensions": [
          ".b+",
          ".bplus",
          ".bp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bplus",
        "scopeName": "source.bplus",
        "path": "./syntaxes/bplus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bplus",
        "path": "./snippets/bplus-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "bplus.run",
        "title": "B+: Run Current File",
        "category": "B+",
        "icon": "$(play)"
      },
      {
        "command": "bplus.build",
        "title": "B+: Build Current File (no run)",
        "category": "B+",
        "icon": "$(tools)"
      },
      {
        "command": "bplus.clean",
        "title": "B+: Launch .exe in Terminal",
        "category": "B+",
        "icon": "$(terminal)"
      }
    ],
    "keybindings": [
      {
        "command": "bplus.run",
        "key": "ctrl+alt+b",
        "when": "editorLangId == bplus && editorTextFocus"
      },
      {
        "command": "bplus.run",
        "key": "f8",
        "when": "editorLangId == bplus && editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bplus.run",
          "when": "editorLangId == bplus",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bplus.run",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.build",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.clean",
          "when": "editorLangId == bplus"
        }
      ],
      "explorer/context": [
        {
          "command": "bplus.run",
          "when": "resourceLangId == bplus",
          "group": "B+@1"
        }
      ]
    },
    "configuration": {
      "title": "B+",
      "properties": {
        "bplus.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to bpc.exe. Empty = use the compiler bundled with the extension, then search PATH and the default zig-out location."
        },
        "bplus.runInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Run compiled .exe inside the integrated terminal so program output is shown."
        },
        "bplus.showOutputChannel": {
          "type": "boolean",
          "default": true,
          "description": "Show compiler diagnostics in the B+ output channel."
        }
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}