{
  "name": "vscode-bplus",
  "displayName": "B+ Language Support",
  "description": "Complete B+ toolchain in one box: syntax highlighting, inline diagnostics, and the bundled bpc compiler — install the extension, write a .b+ file, press F8. Nothing else to download or configure.",
  "version": "0.3.0",
  "publisher": "bplus",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bylka2W/B-Plus.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Other"
  ],
  "keywords": [
    "b+",
    "bplus",
    "language",
    "compiler",
    "metal",
    "plan"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:bplus",
    "workspaceContains:**/*.b+",
    "onCommand:bplus.run",
    "onCommand:bplus.build",
    "onCommand:bplus.runExe",
    "onCommand:bplus.clean",
    "onCommand:bplus.check",
    "onCommand:bplus.doctor",
    "onCommand:bplus.selectCompiler",
    "onCommand:bplus.showOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bplus",
        "aliases": [
          "B+",
          "bplus",
          "b+"
        ],
        "extensions": [
          ".b+",
          ".bplus",
          ".bp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bplus",
        "scopeName": "source.bplus",
        "path": "./syntaxes/bplus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bplus",
        "path": "./snippets/bplus-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "bplus.run",
        "title": "Run Current File",
        "category": "B+",
        "icon": "$(play)"
      },
      {
        "command": "bplus.build",
        "title": "Build Current File",
        "category": "B+",
        "icon": "$(tools)"
      },
      {
        "command": "bplus.runExe",
        "title": "Launch .exe in Terminal",
        "category": "B+",
        "icon": "$(terminal)"
      },
      {
        "command": "bplus.check",
        "title": "Check Current File (diagnostics only)",
        "category": "B+",
        "icon": "$(check)"
      },
      {
        "command": "bplus.clean",
        "title": "Clean (delete built .exe)",
        "category": "B+",
        "icon": "$(trash)"
      },
      {
        "command": "bplus.doctor",
        "title": "Compiler Health Check",
        "category": "B+",
        "icon": "$(pulse)"
      },
      {
        "command": "bplus.selectCompiler",
        "title": "Select Compiler Path...",
        "category": "B+",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bplus.showOutput",
        "title": "Show Output Channel",
        "category": "B+",
        "icon": "$(output)"
      }
    ],
    "keybindings": [
      {
        "command": "bplus.run",
        "key": "f8",
        "when": "editorLangId == bplus && editorTextFocus"
      },
      {
        "command": "bplus.run",
        "key": "f5",
        "when": "editorLangId == bplus && editorTextFocus"
      },
      {
        "command": "bplus.run",
        "key": "ctrl+alt+b",
        "when": "editorLangId == bplus && editorTextFocus"
      },
      {
        "command": "bplus.build",
        "key": "ctrl+alt+shift+b",
        "when": "editorLangId == bplus && editorTextFocus"
      },
      {
        "command": "bplus.check",
        "key": "ctrl+alt+k",
        "when": "editorLangId == bplus && editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bplus.run",
          "when": "editorLangId == bplus",
          "group": "navigation@1"
        },
        {
          "command": "bplus.check",
          "when": "editorLangId == bplus",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "bplus.run",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.build",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.runExe",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.check",
          "when": "editorLangId == bplus"
        },
        {
          "command": "bplus.clean",
          "when": "editorLangId == bplus"
        }
      ],
      "explorer/context": [
        {
          "command": "bplus.run",
          "when": "resourceLangId == bplus",
          "group": "B+@1"
        },
        {
          "command": "bplus.build",
          "when": "resourceLangId == bplus",
          "group": "B+@2"
        }
      ]
    },
    "configuration": {
      "title": "B+",
      "properties": {
        "bplus.compilerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `bpc.exe`. Leave empty to use the compiler **bundled with this extension** (`bin/bpc.exe`), falling back to `PATH` and the default `zig-out` folder."
        },
        "bplus.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Where to put the built .exe. Empty = next to the .b+ source file."
        },
        "bplus.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile the file in the background on every save and show errors as red squiggles."
        },
        "bplus.keepObjectFile": {
          "type": "boolean",
          "default": false,
          "description": "Keep the intermediate .obj next to the .exe instead of deleting it after a successful build."
        },
        "bplus.runInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Run the built .exe inside the integrated terminal so its output is interactive."
        },
        "bplus.clearTerminalBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the B+ Run terminal before launching the program."
        },
        "bplus.showOutputChannel": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the B+ output channel on every build."
        }
      }
    }
  },
  "scripts": {
    "sync-compiler": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-compiler.ps1",
    "package": "npm run sync-compiler && npx @vscode/vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run sync-compiler"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
