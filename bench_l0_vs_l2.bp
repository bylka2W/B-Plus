state Main {
    var data: int[1024 * 1024]
    var sum: int
    var i: int

    on start -> Process
}

state Process {
    on enter -> Process enter {
        data[(i * 7919 + 104729) % (1024 * 1024)] = i
        sum = sum + data[(i * 104729 + 7919) % (1024 * 1024)]
        i = i + 1
    }

    on i >= 100000 -> Done
}

state Done {
    on enter -> Main
}