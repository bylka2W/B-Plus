@echo off
title B+ - Run State Machine

setlocal enabledelayedexpansion

set "FILE=%~1"
if "%FILE%"=="" set "FILE=hello.bp"
if not exist "%FILE%" (
    echo File not found: %FILE%
    echo Usage: run [file.bp]
    exit /b 1
)

echo === B+ Transpiler ===
echo Input: %FILE%
echo.

dotnet run --project "%~dp0src\BPlusTranspiler" -- "%FILE%"
if %ERRORLEVEL% neq 0 (
    echo Transpilation failed
    exit /b %ERRORLEVEL%
)

echo.
echo === Compiling generated C++ ===
call "%~dp0compile.bat"
