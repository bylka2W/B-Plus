# B+ Agent — exclude model weights and build artifacts.
# The model itself is NEVER committed/pushed; only the knowledge web
# (source + prebuilt memory/ table) is released via GitHub.

# Compact knowledge store: ship ONLY the gzip artifact (<=100MB). The raw
# SQLite DB is regenerated locally from source; never push the 282MB raw file.
**/full_zig/knowledge.db

# Model weights
*.pt
**/checkpoints/
**/model/
**/weights/
**/*.safetensors

# Python caches
__pycache__/
*.pyc
.pytest_cache/
*.o
*.egg-info/

# Rebuild / graph-state artifacts (regenerated from source)
**/state/
**/workspace/
**/logs/
**/knowledge/corpus/
**/corpus/

# Dataset / training intermediates
**/training/datasets/
**/*.csv

# Runtime query cache (regenerable)
**/memory/query_cache/

# Memory backups / intermediate snapshots kept out of the release table
**/memory/*_backup*.json
**/memory/*_before_*.json
**/memory/structured_backup.json
**/memory/structured_before_relations.json
**/memory/telemetry.json
**/memory/execution_log.json
**/memory/task_log.json
