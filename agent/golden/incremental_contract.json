{
  "schema": "incremental_contract",
  "version": 1,
  "frozen_at": "2026-08-25T00:00:00",
  "description": "Phase 14 acceptance criteria for incremental, trusted, resource-efficient knowledge indexing",
  "source_snapshot": {
    "schema_version": 1,
    "stored_at": "memory/source_snapshot.json",
    "fields": ["schema", "version", "root", "created_at", "file_count", "tree_sha", "files"],
    "file_entry_fields": ["size", "sha256"],
    "path_normalization": "forward_slash_relative_to_root",
    "guarantees": [
      "tree_sha is deterministic for identical file contents",
      "compare() produces correct added/removed/modified/unchanged/renamed sets",
      "save/load roundtrip preserves tree_sha exactly",
      "empty root produces zero-file snapshot"
    ]
  },
  "dirty_detection": {
    "operations": ["compare"],
    "output_fields": ["added", "removed", "modified", "unchanged", "renamed", "dirty", "dirty_count", "total", "old_tree_sha", "new_tree_sha", "tree_sha_changed"],
    "guarantees": [
      "dirty=True iff any of added/removed/modified is non-empty",
      "renamed detected when same sha256 appears in removed and added",
      "0 dirty means no rebuild needed"
    ]
  },
  "verify_sha_cache": {
    "class": "VerifyEngine",
    "method": "_get_source",
    "behavior": "first call reads file+hashes, subsequent calls return cached (digest, lines)",
    "invalidate_cache": "clears all cached entries",
    "guarantees": [
      "same file hashed once per cache lifetime",
      "cache miss triggers fresh read+hash",
      "invalidate_cache forces re-read on next access"
    ]
  },
  "shared_context_builder": {
    "class": "Knowledge",
    "properties": ["cb", "verify_engine"],
    "guarantees": [
      "Knowledge.load() creates one ContextBuilder shared by AnswerEngine and VerifyEngine",
      "Knowledge.cb returns the shared ContextBuilder",
      "Knowledge.verify_engine returns the VerifyEngine backed by the same CB",
      "k.ve.cb is k.ae.cb (identity, not equality)"
    ]
  },
  "incremental_pipeline": {
    "class": "IncrementalPipeline",
    "method": "run",
    "stages": [
      "snapshot_compare",
      "rebuild_source_index",
      "rebuild_symbols",
      "rebuild_evidence",
      "rebuild_source_relations",
      "rebuild_facts",
      "rebuild_concepts",
      "rebuild_semantic_relations",
      "rebuild_graph",
      "validate",
      "save_snapshot"
    ],
    "output_fields": ["status", "files_changed", "total_files", "time_*", "old_tree_sha", "new_tree_sha", "artifacts"],
    "guarantees": [
      "status='unchanged' when no dirty files detected",
      "status='updated' with per-stage timing when changes detected",
      "post-rebuild SourceStore.validate(deep=True) passes",
      "B+ source tree SHA256 manifest unchanged after run"
    ]
  },
  "security": {
    "injection_in_zig_file": "does not affect engine behavior",
    "source_tree_read_only": "verified by SHA256 manifest check",
    "no_command_from_source": "source files are DATA, not instructions"
  },
  "tests": {
    "test_incremental.py": {
      "TestSourceSnapshot": [
        "test_build_and_compare",
        "test_detect_modify",
        "test_detect_add_and_remove",
        "test_rename_detection",
        "test_save_load_roundtrip",
        "test_bplus_snapshot_builds",
        "test_bplus_unchanged",
        "test_empty_root"
      ],
      "TestVerifyShaCache": [
        "test_cache_hit_avoids_rehash",
        "test_shared_context_builder"
      ],
      "TestIncrementalPipeline": [
        "test_snapshot_unchanged_no_work",
        "test_atomic_write",
        "test_bplus_source_not_modified",
        "test_security_injection_does_not_affect_engine",
        "test_per_file_extraction",
        "test_knowledge_ask_works_with_cache"
      ],
      "total": 16
    }
  },
  "bplus_unchanged_check": {
    "method": "SHA256 manifest comparison",
    "files_checked": "all files in B+ tree",
    "enforced_by": "test_bplus_source_not_modified"
  }
}
