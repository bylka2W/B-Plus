state Start {
    var x: int = 0
    var y: int = 10
    on tick -> Start { x = x + 1; y = y - 1 }
    on tick [x >= 2] -> Middle
    enter { print("S") }
}
state Middle {
    on tick -> End
    enter { print("M") }
}
state End {
    on tick -> Start
    enter { print("E") }
}
entry main() { print("Test") }
