state HeavyCompute {
    var sum: int
    var i: int
    var j: int
    var k: int
    var x: int
    var y: int

    on start -> Compute1 enter {
        sum = 0
        i = 0
        j = 0
        k = 0
        x = 7919
        y = 104729
    }
}

state Compute1 {
    on tick -> Compute2 enter {
        sum = sum + i * 7919 + 104729
        i = i + 1
    }

    on tick [i >= 5000] -> Compute2
}

state Compute2 {
    on tick -> Compute3 enter {
        sum = sum + j * 7919 + 104729
        j = j + 1
    }

    on tick [j >= 5000] -> Compute3
}

state Compute3 {
    on tick -> Compute4 enter {
        sum = sum + k * 7919 + 104729
        k = k + 1
    }

    on tick [k >= 5000] -> Compute4
}

state Compute4 {
    on tick -> Compute5 enter {
        sum = sum + x * y
        x = x + 1
        y = y + 1
    }

    on tick [x >= 10000] -> Compute5
}

state Compute5 {
    on tick -> Compute1 enter {
        sum = sum - i - j - k
        i = 0
        j = 0
        k = 0
        x = 7919
        y = 104729
    }

    on tick [sum > 100000000] -> Done
}

state Done {
    on finish -> HeavyCompute
}