@simd_width(256)
@fsr2_easu
kernel easu(src: Image[1080, 1920]) -> Image[2160, 3840]
    touches: reads[src], writes[output]
    body: src |> easu >> output

@fsr2_rcas(sharpness=0.2)
kernel rcas(src: Image[2160, 3840]) -> Image[2160, 3840]
    touches: reads[src], writes[output]
    body: src |> rcas >> output

entry main()
    print("FSR test compiled")
    return 0
