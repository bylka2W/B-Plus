state MatrixBenchmark {
    var a00: int
    var a01: int
    var a10: int
    var a11: int
    var b00: int
    var b01: int
    var b10: int
    var b11: int
    var c00: int
    var c01: int
    var c10: int
    var c11: int
    var i: int
    var sum: int

    on start -> InitMatrix enter {
        a00 = 1
        a01 = 2
        a10 = 3
        a11 = 4
        b00 = 5
        b01 = 6
        b10 = 7
        b11 = 8
        c00 = 0
        c01 = 0
        c10 = 0
        c11 = 0
        i = 0
        sum = 0
    }
}

state InitMatrix {
    on enter -> Multiply enter {
        a00 = 1 + i
        a01 = 2 + i
        a10 = 3 + i
        a11 = 4 + i
        b00 = 5 + i
        b01 = 6 + i
        b10 = 7 + i
        b11 = 8 + i
    }
}

state Multiply {
    on enter -> SumLoop enter {
        c00 = a00 * b00 + a01 * b10
        c01 = a00 * b01 + a01 * b11
        c10 = a10 * b00 + a11 * b10
        c11 = a10 * b01 + a11 * b11
    }
}

state SumLoop {
    on tick -> Multiply enter {
        sum = sum + c00 + c01 + c10 + c11 + i
        i = i + 1
    }

    on tick [i >= 50000] -> Done
}

state Done {
    on finish -> MatrixBenchmark
}