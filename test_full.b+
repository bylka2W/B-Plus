state Hot {
    var counter: int = 0
    enter { print("Entered Hot") }
    @hot(0.95)
    on tick -> Hot { counter = counter + 1 }
    on switch -> Warm
}

state Warm {
    enter { print("Entered Warm") }
    on tick -> Cold
}

state Cold {
    enter { print("Entered Cold") }
    @cold(0.01)
    on tick -> Hot
}

entry main {
    print("Cache Pyramid Test")
}