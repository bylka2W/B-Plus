state Start {
    var x: int = 0
    on alloc -> Start {
        x = 42;
        print("A")
    }
    on read -> Start {
        print("R")
    }
    on free_it -> Start {
        print("F")
    }
    on done -> Start {
        print("D")
    }
    enter { print("S") }
}
entry main() { print("GO") }
