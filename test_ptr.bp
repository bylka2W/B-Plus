state Start {
    var ptr: ptr
    var x: int = 0
    on tick -> Start { ptr = malloc(32); x = *ptr; free(ptr); x = x + 1 }
    on tick [x >= 2] -> Middle
    enter { print("S") }
}
state Middle {
    on tick -> End
    enter { print("M") }
}
state End {
    on tick -> Start
    enter { print("E") }
}
entry main() { print("Test") }
