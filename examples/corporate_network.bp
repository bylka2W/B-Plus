@corporate_network MyCompany {

    crypto: {
        transport: tls_1_3
        session: double_ratchet
        payload: aes_256_gcm
    }

    access: zero_trust {
        identity: certificate + hardware_key
        session: max(4h)
    }

    segments: [
        { name: finance, vlan: 10, access: [finance_servers] },
        { name: hr, vlan: 20, access: [hr_servers] }
    ]

    state Disconnected {
        on connect -> Connecting
    }

    state Connecting {
        on success -> Connected
    }

    state Connected {
    }
}