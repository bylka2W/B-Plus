-- B+ v2.5.0GH — SPIR-V/GLSL compute shader test
-- Compile: bpc examples/test_spirv.bp --target spirv --gpu-arch amd
-- Then: cd spirv_out && compile_spirv.bat

#lang b+ v2.0
#mode turbo
#target auto

@region(frame)
kernel simple_kernel(src: Image[64,64]) -> Image[64,64]
    body:
        src |> relu |> clamp(0.0, 1.0)

@region(frame)
kernel while_kernel(src: Image[16,16]) -> Image[16,16]
    body:
        src |> while (0.5) { relu } |> clamp(0.0, 1.0)

@region(frame)
kernel warp_kernel(src: Image[64,64]) -> Image[64,64]
    body:
        src |> warp(1, 0) |> relu |> clamp(0.0, 1.0)

entry main()
    run my_pipeline
    ExitCode::Ok
