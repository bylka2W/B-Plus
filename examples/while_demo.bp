#lang b+ v2.0
#mode turbo
#target auto

-- Tests: while(cond) { body } on GPU (dynamic loop) and CPU (single-check)

@region(frame)
kernel test_while_gpu(src: Image[16,16]) -> Image[16,16]
    body:
        src |> while (0.5) { relu } |> clamp(0.0, 1.0)

kernel test_while_cpu(src: Image[16,16]) -> Image[16,16]
    body:
        src |> while (0.5) { relu } |> clamp(0.0, 1.0)

entry main()
    run my_pipeline
    ExitCode::Ok
