-- B+ v2.1.3 — Memory System Demo
-- Three modes: smart / precise / ultra
-- Same syntax, no new/delete, zero leaks

#lang   b+ v2.0
#mode   turbo
#target auto

-- ── Mode: smart — compiler decides everything ──
#memory smart
#vram   budget: 8gb
#ram    budget: 16gb
#cache  auto
#defrag auto
#streaming priority: camera

-- Smart: compiler sees weights are per-frame, never change
-- → auto @pin(vram) + @quant(int8) + @align(cacheline)
weights:    ConvWeights[3,3,3,64] = @load("weights.bin")
textures:   TextureAtlas[1024]    = @stream("textures/")
particles:  ParticleBuffer[100000]

-- ── Mode: precise — you control placement ──
-- #memory precise

@live(vram, always)
@quant(int8)
@align(cacheline)
weights_precise: ConvWeights[3,3,3,64] = @load("w.bin")

@live(ram, when_visible)
@compress(bc7)
@stream(priority: high)
textures_precise: TextureAtlas[1024] = @stream("textures/")

@live(ram, always)
@pool(ring_buffer, 64mb)
particles_precise: ParticleBuffer[100000]

@live(l2_cache, hot)
@align(64)
hot_data: HotBuffer[256]

-- Multi-line @stream with named args + string values
@stream(
    source:   "assets/textures/",
    resident: 512mb,
    evict:    lru,
    prefetch: 2
)
world_textures: TextureAtlas[4096]

-- ── Regions: automatic lifetime management ──
-- frame = dies each frame | session = app lifetime
-- level = until level unload | scene = while active

@region(frame)
kernel upscale_frame(src: Image[H,W]) -> Image[H*2, W*2]
    body:
        src |> convolve(weights) |> relu |> shuffle(2) |> clamp(0.0, 1.0)

@region(session)
@region(level)
@region(scene)

entry main()
    run my_pipeline
    ExitCode::Ok
