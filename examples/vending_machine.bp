import "coin_module.bp"

state Idle {
    on coin_inserted [coin_value >= 10] -> Ready
    enter { display("insert coin") }
}

state Ready {
    on select_item -> Dispensing
    on coin_return -> Idle
    enter { display("select item") }
}

state Dispensing {
    on dispense_done -> Idle
    enter { dispense_item() }
    exit { update_inventory() }
}
