-- B+ v2.5.0GH — Temporal / Frame gen demo
-- Tests: motion_vectors, warp, atomic ops

#lang b+ v2.0
#mode turbo

@region(frame)
kernel temporal_pipeline(src: Image[1920,1080], ref: Image[1920,1080]) -> Image[1920,1080]
    body:
        src |> motion_vectors(ref) |> clamp(0.0, 1.0)

@region(frame)  
kernel warp_demo(src: Image[1920,1080]) -> Image[1920,1080]
    body:
        src |> warp(2, 0) |> relu |> clamp(0.0, 1.0)

@region(frame)
kernel atomic_demo(src: Image[1920,1080]) -> Image[1920,1080]
    body:
        src |> relu |> atomic_add(0.5) |> clamp(0.0, 1.0)

entry main()
    run temporal_pipeline
    run warp_demo
    run atomic_demo
    ExitCode::Ok
