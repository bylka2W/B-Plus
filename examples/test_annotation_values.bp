-- Test: Annotation values — string and numeric args
#lang b+ v2.0
#mode turbo
#target auto

@stream(source: "assets/textures/", resident: 512mb, evict: lru, prefetch: 2)
tex: TextureAtlas[1024]

@live(vram, always)
@quant(int8)
@align(64)
weights: ConvWeights[3,3,3,64]

@pool(ring_buffer, 64mb)
particles: ParticleBuffer[50000]

entry main()
    ExitCode::Ok
