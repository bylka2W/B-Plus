// B+ Semantic Goto — test: context-aware streaming parser
#parser

state HttpParser {
    @fast_path
    var buffer_pos: int
    on 'H' -> ExpectHeader
    on 'G' -> ExpectGet
}

state ExpectHeader {
    @hot(0.9)
    on ':' -> ReadingValue
    on '\n' -> HttpParser
}

state ReadingValue {
    @hot(0.95)
    on '\n' -> HttpParser
    on ' ' -> ReadingValue
}

state ExpectGet {
    on 'E' -> ExpectGet
    on 'T' -> ExpectGet
    on ' ' -> HttpParser
}

state Error {
    on '\n' -> HttpParser
}
