-- B+ v2.5.0GH — DXIL/HLSL compute shader test
-- Compile: bpc examples/test_dxil.bp --target dxil --gpu-arch nvidia
-- Then: cd dxil_out && compile_dxil.bat

#lang b+ v2.0
#mode turbo
#target auto

@region(frame)
kernel simple_kernel(src: Image[64,64]) -> Image[64,64]
    body:
        src |> relu |> clamp(0.0, 1.0)

@region(frame)
kernel conv_kernel(src: Image[128,128]) -> Image[128,128]
    body:
        src |> convolve |> relu |> clamp(0.0, 1.0)

@region(frame)
kernel shuffle_kernel(src: Image[32,32]) -> Image[64,64]
    body:
        src |> relu |> shuffle(2) |> clamp(0.0, 1.0)

entry main()
    run my_pipeline
    ExitCode::Ok
