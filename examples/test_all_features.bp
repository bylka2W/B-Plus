// B+ v2.5.0GH — Full feature test: @hot/@cold, #memory comptime, Semantic Inline, SIMD
#memory comptime

@simd_width(512)
@simd_unroll(8)
@simd_gather
kernel upscale(src: Image[1080, 1920]) -> Image[2160, 3840]
    touches: reads[src], writes[output]
    body: src |> relu |> shuffle >> output

state Idle {
    @hot(0.9)
    on start -> Running
    @cold(0.01)
    on error -> Error
}

state Running {
    @hot(0.85)
    on jump -> Jumping
    @cold(0.05)
    on crash -> Error
    on stop -> Idle
}

state Jumping {
    @hot(0.95)
    on land -> Idle
}

state Error {
    on retry -> Idle
}
