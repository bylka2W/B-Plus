context {
    var max_score: int = 1000
}

state Game {
    var score: int = 0
    var lives: int = 3

    on hit -> Game { score += 10 }

    on die [lives <= 1] -> GameOver
    on die[lives>1]->Game{ lives -= 1 }

    enter { start_game() }
}

state GameOver {
    on restart -> Game { reset_score() }
    enter { show_game_over() }
}
