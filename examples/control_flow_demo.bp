-- B+ v2.5.0GH — Control flow in kernels
-- Tests: if/else, for loops

#lang b+ v2.0
#mode turbo

@region(frame)
kernel if_demo(src: Image[1920,1080]) -> Image[1920,1080]
    body:
        src |> if (0.5) { relu } else { clamp(0.0, 0.5) }

@region(frame)
kernel for_demo(src: Image[1920,1080]) -> Image[1920,1080]
    body:
        src |> for (3) { relu } |> clamp(0.0, 1.0)

entry main()
    run if_demo
    run for_demo
    ExitCode::Ok
