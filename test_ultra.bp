enum Weapon { Sword, Bow, Staff }
enum Armor { Light, Heavy, Magic }
enum Emotion { Happy, Angry, Scared }

context {
    var max_hp: int = 100
    var max_mana: int = 50
    var difficulty: int = 2
    var god_mode: bool = false
}

@simd_width(256)
@simd_unroll(4)
kernel ai_sensor(
    players: Image[64, 64],
    enemies: Image[64, 64],
    map: Image[256, 256]
) -> Image[64, 64]
    touches: reads[players, enemies, map], writes[output]
    body: players |> merge(enemies) |> filter |> normalize >> output

pipeline combat_pipeline {
    stage: calc_damage
    stage: apply_armor
    stage: check_crits
    stage: update_hp
}

state Idle {
    var hp: int = max_hp
    var mana: int = max_mana
    var weapon: Weapon = Sword
    var armor: Armor = Light
    var gold: int = 0
    var xp: int = 0
    
    @hot(0.8)
    on explore -> Exploring
    enter { }
    
    @cold(0.05)
    on ambush -> Combat
    enter { hp = hp - 10 }
    
    on shop_enter -> Shopping
    enter { }
    
    on rest -> Idle
    enter { hp = hp + 20; mana = mana + 10 }
    
    on rest [hp >= max_hp && mana >= max_mana] -> Idle
    enter { }
}

state Exploring {
    var zone: int = 1
    var steps: int = 0
    
    @hot(0.6)
    on move -> Exploring
    enter { steps = steps + 1 }
    
    on find_loot -> Exploring
    enter { gold = gold + 50; xp = xp + 10 }
    
    on find_loot [gold >= 500] -> Shopping
    enter { }
    
    on enemy_spotted [hp > 20] -> Combat
    enter { weapon = Sword }
    
    on enemy_spotted [hp <= 20] -> Idle
    enter { }
    
    on zone_clear [zone >= 5] -> Idle
    enter { gold = gold + 200 }
    
    on zone_clear [zone < 5] -> Exploring
    enter { zone = zone + 1 }
    
    on rest -> Idle
    enter { }
    
    enter { steps = 0 }
    exit { }
}

state Combat {
    var enemy_hp: int = 50
    var combo: int = 0
    var turn: int = 1
    
    @hot(0.5)
    on attack -> Combat
    enter {
        enemy_hp = enemy_hp - 10;
        combo = combo + 1;
        turn = turn + 1
    }
    
    on attack [enemy_hp <= 0] -> Idle
    enter {
        xp = xp + 100;
        gold = gold + 75;
        combo = 0
    }
    
    @hot(0.3)
    on defend -> Combat
    enter {
        hp = hp + 5;
        turn = turn + 1
    }
    
    @hot(0.1)
    on cast_spell -> Combat
    enter {
        enemy_hp = enemy_hp - 25;
        mana = mana - 15;
        combo = combo + 2;
        turn = turn + 1
    }
    
    on cast_spell [mana < 15] -> Combat
    enter { }
    
    on flee [hp > 10] -> Exploring
    enter { hp = hp - 5 }
    
    on flee [hp <= 10] -> Idle
    enter { }
    
    on enemy_crit -> Combat
    enter { hp = hp - 30 }
    
    on enemy_crit [hp <= 0] -> Dead
    enter { }
    
    enter {
        enemy_hp = 50 + difficulty * 10;
        combo = 0;
        turn = 1
    }
    exit {
        combo = 0
    }
}

state Shopping {
    var budget: int = gold
    
    @hot(0.4)
    on buy_sword [gold >= 100] -> Shopping
    enter {
        gold = gold - 100;
        weapon = Sword
    }
    
    on buy_bow [gold >= 150] -> Shopping
    enter {
        gold = gold - 150;
        weapon = Bow
    }
    
    on buy_staff [gold >= 200] -> Shopping
    enter {
        gold = gold - 200;
        weapon = Staff
    }
    
    on buy_armor [gold >= 80] -> Shopping
    enter {
        gold = gold - 80;
        armor = Heavy
    }
    
    on leave -> Idle
    enter { }
    
    on leave [gold <= 0] -> Idle
    enter { }
}

state Dead {
    var death_count: int = 0
    
    on respawn [god_mode == true] -> Idle
    enter {
        hp = max_hp;
        mana = max_mana;
        death_count = death_count + 1
    }
    
    on respawn [god_mode == false && death_count < 3] -> Idle
    enter {
        hp = max_hp / 2;
        mana = max_mana / 2;
        gold = gold / 2;
        death_count = death_count + 1
    }
    
    on game_over -> Idle
    enter {
        hp = max_hp;
        mana = max_mana;
        gold = 0;
        xp = 0;
        death_count = 0
    }
    
    enter { }
}

parallel {
    update_ai()
    update_physics()
    update_render()
    update_audio()
    update_network()
}

entry main() {
}