{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B+",
  "scopeName": "source.bplus",
  "fileTypes": [".b+"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.bplus" },
        { "match": "--.*$", "name": "comment.line.double-dash.bplus" }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "match": "@\\w+(\\([^)]*\\))?",
          "name": "keyword.decorator.bplus"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.bplus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\[nrt0\\\\\"]", "name": "constant.character.escape.bplus" }
      ]
    },
    "numbers": {
      "match": "\\b(0x[0-9a-fA-F_]+|\\d+(\\.\\d+)?)\\b",
      "name": "constant.numeric.bplus"
    },
    "keywords": {
      "patterns": [
        { "include": "#control-keywords" },
        { "include": "#entity-keywords" },
        { "include": "#constants" }
      ]
    },
    "control-keywords": {
      "patterns": [
        { "match": "\\b(on|always|entry|exit|context|var|enum|kernel|extern|parallel)\\b", "name": "keyword.control.bplus" },
        { "match": "\\b(state)\\s+(\\w+)", "captures": { "1": { "name": "keyword.control.bplus" }, "2": { "name": "entity.name.type.bplus" } } }
      ]
    },
    "entity-keywords": {
      "match": "\\bfn\\b",
      "name": "keyword.control.bplus"
    },
    "constants": {
      "match": "\\b(Self|true|false)\\b",
      "name": "constant.language.bplus"
    },
    "types": {
      "match": "\\b(int8|i8|u8|byte|bool|int16|i16|u16|short|half|int32|i32|u32|int|uint|float|int64|i64|u64)\\b",
      "name": "storage.type.bplus"
    },
    "operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.bplus" },
        { "match": "[+\\-*/%]=?", "name": "keyword.operator.assignment.bplus" },
        { "match": "==|!=|>=?|<=?", "name": "keyword.operator.comparison.bplus" }
      ]
    }
  }
}
