{
  "name": "bplus-syntax",
  "displayName": "B+ Language Syntax",
  "description": "Syntax highlighting for B+ (.b+) transition machine language",
  "version": "0.1.0",
  "publisher": "bylka2W",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "bplus",
        "aliases": ["B+", "bplus"],
        "extensions": [".b+"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bplus",
        "scopeName": "source.bplus",
        "path": "./syntaxes/bplus.tmLanguage.json"
      }
    ]
  }
}
