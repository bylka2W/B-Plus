context {
    var pi: float = 3.14159
    var app_name: string = "B+ Test Suite"
    var debug: bool = true
    var retries: int = 3
}

state Init {
    var counter: int = 0
    var result: float = 0.0
    var msg: string = "starting"

    on start -> Compute enter {
        counter = 0;
        result = 0.0;
        msg = "init done"
    }

    on skip -> Done enter { }
}

state Compute {
    var i: int = 0
    var sum: float = 0.0
    var product: int = 1
    var text: string = ""

    @hot(0.8)
    on loop -> Compute enter {
        i = i + 1;
        sum = sum + i * pi;
        product = product * i;
        text = "iteration " + i
    }

    on loop [i >= 10] -> Validate enter {
        result = sum;
        msg = "computed " + i + " iterations"
    }

    on reset -> Init enter { }
}

state Validate {
    var passed: bool = false
    var checks: int = 0

    on check [result > 0.0 && product > 1] -> Validate enter {
        passed = true;
        checks = checks + 1
    }

    on check [result <= 0.0 || product <= 1] -> Validate enter {
        passed = false;
        checks = checks + 1
    }

    on check [checks >= 5 && passed == true] -> Done enter {
        msg = "all checks passed"
    }

    on check [checks >= 5 && passed == false] -> Init enter {
        msg = "validation failed, retrying"
    }

    on retry [retries > 0] -> Init enter {
        retries = retries - 1
    }

    on retry [retries <= 0] -> Done enter {
        msg = "out of retries"
    }
}

state Done {
    on restart -> Init enter { }
    on exit -> Done enter { }
    enter {
        debug = false
    }
}

entry main() {
}